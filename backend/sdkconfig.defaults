# Required for the WebSocket interface (frontend <-> backend).
CONFIG_HTTPD_WS_SUPPORT=y

# Custom partition table (factory + OTA + SPIFFS storage). Shared by every
# env: all our boards ship 4MB+ flash so one 4MB layout fits all.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"

# Must match the partition table above: stale 2MB values in generated
# sdkconfig files trigger PIO's flash-size-mismatch warning and misconfigure
# the bootloader on 4MB layouts.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# MQTT client (publish air quality readings).
CONFIG_MQTT_PROTOCOL_311=y

# Zigbee stack requirements (from the esp-zigbee-lib HA examples). Crypto
# only — the stack itself is enabled per-target via src/Kconfig.projbuild,
# so these harmless mbedTLS options ride along on classic builds too.
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_MPI=n
CONFIG_MBEDTLS_HARDWARE_SHA=n
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y

# Socket budget: httpd takes up to max_open_sockets (10) + control socket,
# MQTT holds 1-2, browsers open 6+ parallel conns per tab. Default 10
# starves accept() with ENFILE as soon as a page loads.
CONFIG_LWIP_MAX_SOCKETS=16

# HomeKit HAP server port. Ours owns 80 (UI + OTA + WS); HAP gets its own
# listener — iOS follows the mDNS-advertised port, any value works.
CONFIG_HAP_HTTP_SERVER_PORT=8080

# Size-optimized build so the app fits the OTA slots on 2MB flash.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Disable assertions to reclaim flash (kept INFO console logs).
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# Single-radio Wi-Fi/802.15.4 coexistence (C6): the arbiter time-slices
# via the PM/modem-sleep framework. Runtime calls in main.c (PM), wifi.c
# (coex PS handover) and zigbee_stack.c (arbiter enable) are required too.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_COEX_POWER_MANAGEMENT=y
CONFIG_PM_ENABLE=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_FREERTOS_HZ=1000