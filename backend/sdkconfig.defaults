# Required for the WebSocket interface (frontend <-> backend).
CONFIG_HTTPD_WS_SUPPORT=y

# Custom partition table (factory + OTA + SPIFFS storage). Shared by every
# env: all our boards ship 4MB+ flash so one 4MB layout fits all.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"

# Must match the partition table above: stale 2MB values in generated
# sdkconfig files trigger PIO's flash-size-mismatch warning and misconfigure
# the bootloader on 4MB layouts.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# MQTT client (publish air quality readings).
CONFIG_MQTT_PROTOCOL_311=y

# Socket budget: httpd takes up to max_open_sockets (10) + control socket,
# MQTT holds 1-2, browsers open 6+ parallel conns per tab. Default 10
# starves accept() with ENFILE as soon as a page loads.
CONFIG_LWIP_MAX_SOCKETS=16

# Size-optimized build so the app fits the OTA slots on 2MB flash.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Disable assertions to reclaim flash (kept INFO console logs).
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y


