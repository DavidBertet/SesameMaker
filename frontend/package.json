{
  "name": "sesamemaker",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"vite\" \"node mock-ws-server.cjs\"",
    "build": "vite build && rm -f dist/SetupTab-*.js && mkdir -p ../backend/data && rm -rf ../backend/data/* && find dist -name '*.map' -exec gzip {} \\; && cp -r dist/* ../backend/data",
    "build:github": "vite build --mode github",
    "test": "node --test src/core/lib/*.test.js src/app/lib/*.test.js",
    "lint": "prettier --check \"src/**/*.{js,ts,svelte,html,css,json}\"",
    "format": "prettier --write \"src/**/*.{js,ts,svelte,html,css,json}\""
  },
  "type": "module",
  "devDependencies": {
    "@internationalized/date": "^3.8.2",
    "@lucide/svelte": "^0.513.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "bits-ui": "^2.5.0",
    "clsx": "^2.1.1",
    "concurrently": "^8.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.0.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.3.0",
    "tailwind-variants": "^1.0.0",
    "tw-animate-css": "^1.3.4",
    "vite": "^6.3.5",
    "vite-plugin-compression2": "^2.0.1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "esptool-js": "^0.7.0",
    "lucide-svelte": "^0.513.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.8",
    "ws": "^8.18.2"
  }
}
